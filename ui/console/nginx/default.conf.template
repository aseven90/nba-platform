# Serves the console and routes each TMF API to its service, so the browser talks to one origin.
# Upstream URLs come from the environment (envsubst runs on start-up in the nginx image).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;

    location /tmf-api/productCatalogManagement/ { proxy_pass ${CATALOG_URL}; }
    location /tmf-api/promotionManagement/ { proxy_pass ${CAMPAIGN_URL}; }
    location /tmf-api/recommendationManagement/ { proxy_pass ${DECISION_URL}; }
    location /tmf-api/partyInteractionManagement/ { proxy_pass ${INTERACTION_URL}; }

    # Same probe paths as the Java services, so the shared Helm chart works unchanged.
    location = /actuator/health/liveness { default_type application/json; return 200 '{"status":"UP"}'; }
    location = /actuator/health/readiness { default_type application/json; return 200 '{"status":"UP"}'; }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the app shell.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
