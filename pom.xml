<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>io.nbaplatform</groupId>
  <artifactId>nba-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NBA Platform</name>
  <description>Industry-agnostic Next Best Action campaign management platform</description>

  <modules>
    <module>libs/event-contracts</module>
    <module>libs/platform-starter</module>
    <module>services/action-catalog-service</module>
    <module>services/campaign-service</module>
    <module>services/interaction-service</module>
    <module>services/decision-service/decision-spi</module>
    <module>services/decision-service/decision-plugins-core</module>
    <module>services/decision-service/decision-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <resilience4j.version>2.3.0</resilience4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.nbaplatform</groupId>
        <artifactId>event-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nbaplatform</groupId>
        <artifactId>platform-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nbaplatform</groupId>
        <artifactId>decision-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nbaplatform</groupId>
        <artifactId>decision-plugins-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
